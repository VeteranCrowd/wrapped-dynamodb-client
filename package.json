{
  "name": "@veterancrowd/wrapped-dynamodb-client",
  "version": "1.6.19",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/VeteranCrowd/wrapped-dynamodb-client"
  },
  "author": "Jason G. Williscroft",
  "bugs": {
    "url": "https://github.com/VeteranCrowd/wrapped-dynamodb-client/issues"
  },
  "description": "An AWS DynamoDB client wrapped to provide consistent logging and other services.",
  "homepage": "https://github.com/VeteranCrowd/wrapped-dynamodb-client#readme",
  "keywords": [
    "dynamodb",
    "logging"
  ],
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.609.0",
    "@aws-sdk/lib-dynamodb": "^3.609.0",
    "aws-xray-sdk": "^3.9.0",
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "@babel/cli": "^7.24.7",
    "@babel/core": "^7.24.7",
    "@babel/eslint-parser": "^7.24.7",
    "@babel/plugin-syntax-import-assertions": "^7.24.7",
    "@babel/preset-env": "^7.24.7",
    "@babel/register": "^7.24.6",
    "@types/node": "^20.14.9",
    "@veterancrowd/aws-cli": "^6.0.12",
    "auto-changelog": "^2.4.0",
    "babel-plugin-lodash": "^3.3.4",
    "chai": "^5.1.1",
    "chai-match-pattern": "^1.3.0",
    "concat-md": "^0.5.1",
    "crlf": "^1.1.1",
    "eslint": "=8",
    "eslint-plugin-jsdoc": "^48.5.0",
    "eslint-plugin-mocha": "^10.4.3",
    "eslint-plugin-promise": "^6.4.0",
    "jsdoc-to-markdown": "^8.0.1",
    "knip": "^5.23.3",
    "lefthook": "^1.6.18",
    "mocha": "^10.6.0",
    "nanoid": "^5.0.7",
    "release-it": "^17.4.1",
    "uuid": "^10.0.0"
  },
  "exports": {
    ".": {
      "import": "./lib/index.js",
      "require": "./dist/default/lib/index.js"
    }
  },
  "main": "./lib/index.js",
  "mocha": {
    "exclude": [
      "./dist/**",
      "./node_modules/**"
    ],
    "file": "./test/setup.js",
    "require": [
      "@babel/register",
      "chai-match-pattern"
    ],
    "spec": "./**/*.test.!(*.*)",
    "timeout": 60000
  },
  "release-it": {
    "git": {
      "changelog": "npx auto-changelog --stdout --commit-limit false -u --template https://raw.githubusercontent.com/release-it/release-it/main/templates/changelog-compact.hbs",
      "requireBranch": "dev",
      "commitMessage": "chore: release v${version}"
    },
    "github": {
      "release": true
    },
    "hooks": {
      "after:init": [
        "nr lint",
        "nr test",
        "nr build",
        "nr doc"
      ],
      "after:release": [
        "git switch -c release/${version}",
        "git push -u origin release/${version}",
        "git switch ${branchName}"
      ]
    },
    "npm": {
      "publish": true
    }
  },
  "scripts": {
    "build": "babel lib -d dist/default/lib --delete-dir-on-start --config-file ./dist/default/.babelrc",
    "doc": "jsdoc2md -c doc/jsdoc.config.json -f lib/**/*.* -t doc/api-template.hbs > doc/2-api.jsdoc2.md && concat-md doc --hide-anchor-links > README.md",
    "knip": "knip",
    "lint": "eslint lib/**",
    "release": "vc -c \"release-it\"",
    "release:pre": "vc -c \"release-it --no-git.requireBranch --github.prerelease --preRelease\"",
    "test": "vc -c \"mocha\""
  },
  "type": "module"
}
